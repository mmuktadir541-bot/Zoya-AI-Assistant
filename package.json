{
  "name": "zoya-ai-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time voice-to-voice AI assistant featuring Zoya - witty, sassy, and intelligent Android companion",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "express": "^5.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uuid": "^13.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
